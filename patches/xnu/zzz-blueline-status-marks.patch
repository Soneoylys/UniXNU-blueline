  * blueline bring-up: one block per call along bands 13 and 14 (32 blocks a row), so a photograph shows how many
  * bsd_init steps ran. Every fifth block is yellow and every tenth red.
  */
+void blueline_mark(unsigned int slot, uint32_t color);
+void
+blueline_mark(unsigned int slot, uint32_t color)
+{
+	/* blueline bring-up: slot 0..7 of band 15 (the bottom band) */
+	if (vinfo.v_baseaddr == 0 || vinfo.v_depth != 32 || slot >= 8) {
+		return;
+	}
+	unsigned int h = vinfo.v_height / 16, w = vinfo.v_width / 8;
+	unsigned int top = 15 * h, left = slot * w;
+	for (unsigned int y = top; y + 8 < top + h; y++) {
+		volatile uint32_t *row = (volatile uint32_t *)(vinfo.v_baseaddr + (unsigned long)y * vinfo.v_rowbytes);
+		for (unsigned int x = left; x + 8 < left + w; x++) {
+			row[x] = color;
+		}
+	}
+	__builtin_arm_dsb(DSB_SY);
+}
+
 void blueline_step(void);
 void
 blueline_step(void)
 {
 	static unsigned int steps;
 	unsigned int i = steps++;
+	if (i >= 64) {
+		blueline_mark(6, 0x00FF00FF);   /* the step counter is already past 64: corrupted */
+	}
 	if (vinfo.v_baseaddr == 0 || vinfo.v_depth != 32 || i >= 64) {
 		return;
 	}
