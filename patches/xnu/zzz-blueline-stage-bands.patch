--- a/osfmk/console/video_console.c
+++ b/osfmk/console/video_console.c
@@ -118,6 +118,27 @@
 
 struct vc_info vinfo;
 
+/*
+ * blueline bring-up: paint band n of 16 across the panel (DarwinBoot paints band 0, the entry probe bands 1 and 2), so
+ * a photograph shows the last kernel stage reached when there is no serial port and no panic text.
+ */
+void blueline_band(unsigned int n, uint32_t color);
+void
+blueline_band(unsigned int n, uint32_t color)
+{
+	if (vinfo.v_baseaddr == 0 || vinfo.v_depth != 32 || n >= 16) {
+		return;
+	}
+	unsigned int h = vinfo.v_height / 16;
+	for (unsigned int y = n * h; y + 8 < n * h + h; y++) {
+		volatile uint32_t *row = (volatile uint32_t *)(vinfo.v_baseaddr + (unsigned long)y * vinfo.v_rowbytes);
+		for (unsigned int x = 0; x < vinfo.v_width; x++) {
+			row[x] = color;
+		}
+	}
+	__builtin_arm_dsb(DSB_SY);
+}
+
 void noroot_icon_test(void);
 
 
