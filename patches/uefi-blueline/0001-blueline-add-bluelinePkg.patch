+##
+#  Copyright (c) 2011 - 2022, ARM Limited. All rights reserved.
+#  Copyright (c) 2014, Linaro Limited. All rights reserved.
+#  Copyright (c) 2015 - 2020, Intel Corporation. All rights reserved.
+#  Copyright (c) 2018, Bingxing Wang. All rights reserved.
+#  Copyright (c) Microsoft Corporation.
+#
+#  SPDX-License-Identifier: BSD-2-Clause-Patent
+##
+
+################################################################################
+#
+# Defines Section - statements that will be processed to create a Makefile.
+#
+################################################################################
+[Defines]
+  PLATFORM_NAME                  = blueline
+  PLATFORM_GUID                  = 3B0C9F4E-6E1D-4C8A-9F52-B1C1D8450003
+  PLATFORM_VERSION               = 0.1
+  DSC_SPECIFICATION              = 0x00010005
+  OUTPUT_DIRECTORY               = Build/bluelinePkg
+  SUPPORTED_ARCHITECTURES        = AARCH64
+  BUILD_TARGETS                  = RELEASE|DEBUG
+  SKUID_IDENTIFIER               = DEFAULT
+  FLASH_DEFINITION               = bluelinePkg/blueline.fdf
+
+  #
+  # 1: the stock XBL DisplayDxe initializes the panel (as polaris). 0: SimpleFbDxe takes over the framebuffer
+  # ABL left at 0x9D400000. The build command line (-D USE_CUSTOM_DISPLAY_DRIVER=...) selects one.
+  #
+!ifndef USE_CUSTOM_DISPLAY_DRIVER
+  DEFINE USE_CUSTOM_DISPLAY_DRIVER = 1
+!endif
+
+  #
+  # 1: load the stock Pixel 3 XBL drivers (SMEM, clocks, RPMh, PMIC, UFS, USB, buttons, ...), as polaris.
+  # 0: Mu drivers only (as sheng's SHENG_VENDOR_HW = 0): no UFS and no keys, but nothing touches the panel ABL
+  #    left scanning out, and DRAM comes from ABL's FDT (BluelineBootMemoryDxe).
+  #
+!ifndef BLUELINE_VENDOR_HW
+  DEFINE BLUELINE_VENDOR_HW = 1
+!endif
+
+!include NapaliPkg/NapaliPkg.dsc.inc
+
+!if ($(USE_CUSTOM_DISPLAY_DRIVER) == 1) && ($(BLUELINE_VENDOR_HW) == 0)
+  !error The stock DisplayDxe chain needs BLUELINE_VENDOR_HW = 1
+!endif
+
+[PcdsFixedAtBuild]
+  #
+  # DDR Memory
+  #
+  gArmTokenSpaceGuid.PcdSystemMemoryBase|0x80000000
+
+  #
+  # UEFI Stack
+  #
+  gArmPlatformTokenSpaceGuid.PcdCPUCoresStackBase|0x9FF90000
+  gArmPlatformTokenSpaceGuid.PcdCPUCorePrimaryStackSize|0x40000
+
+  #
+  # SMBIOS
+  #
+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosSystemManufacturer|"Google"
+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosSystemModel|"Pixel 3"
+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosSystemRetailModel|"blueline"
+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosSystemRetailSku|"Pixel_3_blueline"
+  gSiliciumPkgTokenSpaceGuid.PcdSmbiosSystemBoardModel|"B1 DVT1.1"
+
+  #
+  # Simple Frame Buffer
+  #
+  gSiliciumPkgTokenSpaceGuid.PcdFrameBufferWidth|1080
+  gSiliciumPkgTokenSpaceGuid.PcdFrameBufferHeight|2160
+  gSiliciumPkgTokenSpaceGuid.PcdFrameBufferColorDepth|32
+
+  #
+  # Platform PEI
+  #
+  gQcomPkgTokenSpaceGuid.PcdPlatformType|"LA"
+!if $(BLUELINE_VENDOR_HW) == 0
+  # As sheng: without the stock drivers nothing reads the HOBs of the stock UEFI's leftover FD window.
+  gQcomPkgTokenSpaceGuid.PcdBuildXblHobs|FALSE
+!endif
+
+[Components]
+  #
+  # UniXNU boot manager and XNU loader (as uefi-sheng)
+  #
+  UniXNUPkg/Application/UniXNU/UniXNU.inf
+  UniXNUPkg/Driver/UniXNUDxe/UniXNUDxe.inf
+  UniXNUPkg/Driver/UniXNURamDiskDxe/UniXNURamDiskDxe.inf
+  DarwinBootPkg/Driver/DarwinBoot.inf
+  bluelinePkg/Drivers/BluelineBootMemoryDxe/BluelineBootMemoryDxe.inf
+
+[LibraryClasses]
+  UniXNULib|UniXNUPkg/Library/UniXNULib/UniXNULib.inf
+  FdtLib|MdePkg/Library/BaseFdtLib/BaseFdtLib.inf
+
+  #
+  # Memory Libraries
+  #
+  MemoryMapLib|bluelinePkg/Library/MemoryMapLib/MemoryMapLib.inf
+
+  #
+  # QCOM Libraries
+  #
+  ConfigurationMapLib|bluelinePkg/Library/ConfigurationMapLib/ConfigurationMapLib.inf
diff --git a/Platforms/Google/bluelinePkg/blueline.fdf b/Platforms/Google/bluelinePkg/blueline.fdf
new file mode 100644
index 00000000..5db45d63
--- /dev/null
+++ b/Platforms/Google/bluelinePkg/blueline.fdf
@@ -0,0 +1,137 @@
+##
+#  Copyright (c) 2018, Linaro Limited. All rights reserved.
+#
+#  SPDX-License-Identifier: BSD-2-Clause-Patent
+##
+
+################################################################################
+#
+# FD Section
+# The [FD] Section is made up of the definition statements and a
+# description of what goes into  the Flash Device Image.  Each FD section
+# defines one flash "device" image.  A flash device image may be one of
+# the following: Removable media bootable image (like a boot floppy
+# image,) an Option ROM image (that would be "flashed" into an add-in
+# card,) a System "Flash"  image (that would be burned into a system's
+# flash) or an Update ("Capsule") image that will be used to update and
+# existing system flash.
+#
+################################################################################
+
+[FD.SILICIUM_UEFI]
+BaseAddress   = $(FD_BASE)|gArmTokenSpaceGuid.PcdFdBaseAddress # The base address of the FLASH Device.
+Size          = $(FD_SIZE)|gArmTokenSpaceGuid.PcdFdSize        # The size in bytes of the FLASH Device
+ErasePolarity = 1
+
+# This one is tricky, it must be: BlockSize * NumBlocks = Size
+BlockSize     = 0x1000
+NumBlocks     = $(FD_BLOCKS)
+
+################################################################################
+#
+# Following are lists of FD Region layout which correspond to the locations of different
+# images within the flash device.
+#
+# Regions must be defined in ascending order and may not overlap.
+#
+# A Layout Region start with a eight digit hex offset (leading "0x" required) followed by
+# the pipe "|" character, followed by the size of the region, also in hex with the leading
+# "0x" characters. Like:
+# Offset|Size
+# PcdOffsetCName|PcdSizeCName
+# RegionType <FV, DATA, or FILE>
+#
+################################################################################
+
+0x00000000|$(FD_SIZE)
+gArmTokenSpaceGuid.PcdFvBaseAddress|gArmTokenSpaceGuid.PcdFvSize
+FV = FVMAIN_COMPACT
+
+################################################################################
+#
+# FV Section
+#
+# [FV] section is used to define what components or modules are placed within a flash
+# device file.  This section also defines order the components and modules are positioned
+# within the image.  The [FV] section consists of define statements, set statements and
+# module statements.
+#
+################################################################################
+
+[FV.FvMain]
+FvNameGuid         = CD8D4C84-20AD-4073-8A28-3400FAE05941
+BlockSize          = 0x1000
+NumBlocks          = 0        # This FV gets compressed so make it just big enough
+FvAlignment        = 8        # FV alignment and FV attributes setting.
+ERASE_POLARITY     = 1
+MEMORY_MAPPED      = TRUE
+STICKY_WRITE       = TRUE
+LOCK_CAP           = TRUE
+LOCK_STATUS        = TRUE
+WRITE_DISABLED_CAP = TRUE
+WRITE_ENABLED_CAP  = TRUE
+WRITE_STATUS       = TRUE
+WRITE_LOCK_CAP     = TRUE
+WRITE_LOCK_STATUS  = TRUE
+READ_DISABLED_CAP  = TRUE
+READ_ENABLED_CAP   = TRUE
+READ_STATUS        = TRUE
+READ_LOCK_CAP      = TRUE
+READ_LOCK_STATUS   = TRUE
+
+  !include Include/APRIORI.inc
+  !include Include/DXE.inc
+  !include Include/RAW.inc
+
+  # RAM Manager reads the RAM partition table published by the stock drivers.
+!if $(BLUELINE_VENDOR_HW) == 1
+  INF SiliciumPkg/Drivers/RamManagerDxe/RamManagerDxe.inf
+!endif
+
+  # SmBios
+  INF MdeModulePkg/Universal/SmbiosDxe/SmbiosDxe.inf
+  INF SiliciumPkg/Drivers/SmBiosTableDxe/SmBiosTableDxe.inf
+
+  # UniXNU
+  INF UniXNUPkg/Application/UniXNU/UniXNU.inf
+  INF UniXNUPkg/Driver/UniXNUDxe/UniXNUDxe.inf
+
+  # ACPI: the table protocol only; XNU takes the Apple device tree, and no ACPI tables are installed
+  INF MdeModulePkg/Universal/Acpi/AcpiTableDxe/AcpiTableDxe.inf
+
+  # Device Tree
+  #INF EmbeddedPkg/Drivers/DtPlatformDxe/DtPlatformDxe.inf
+  #FILE FREEFORM = 25462CDA-221F-47DF-AC1D-259CFAA4E326 {
+  #  SECTION RAW = bluelinePkg/FdtBlob/sdm845-google-blueline.dtb
+  #  SECTION UI = "DeviceTreeBlob"
+  #}
+
+  !include QcomPkg/Extra.fdf.inc
+
+[FV.FVMAIN_COMPACT]
+FvAlignment        = 8
+ERASE_POLARITY     = 1
+MEMORY_MAPPED      = TRUE
+STICKY_WRITE       = TRUE
+LOCK_CAP           = TRUE
+LOCK_STATUS        = TRUE
+WRITE_DISABLED_CAP = TRUE
+WRITE_ENABLED_CAP  = TRUE
+WRITE_STATUS       = TRUE
+WRITE_LOCK_CAP     = TRUE
+WRITE_LOCK_STATUS  = TRUE
+READ_DISABLED_CAP  = TRUE
+READ_ENABLED_CAP   = TRUE
+READ_STATUS        = TRUE
+READ_LOCK_CAP      = TRUE
+READ_LOCK_STATUS   = TRUE
+
+  INF SiliciumPkg/Sec/Sec.inf
+
+  FILE FV_IMAGE = 9E21FD93-9C72-4c15-8C4B-E77F1DB2D792 {
+    SECTION GUIDED EE4E5898-3914-4259-9D6E-DC7BD79403CF PROCESSING_REQUIRED = TRUE {
+      SECTION FV_IMAGE = FVMAIN
+    }
+  }
+
+  !include SiliciumPkg/Common.fdf.inc
diff --git a/Resources/Configs/blueline.toml b/Resources/Configs/blueline.toml
new file mode 100644
index 00000000..89afbe54
--- /dev/null
+++ b/Resources/Configs/blueline.toml
@@ -0,0 +1,32 @@
+#
+# Boot Shim Configs
+#
+[boot_shim]
+requires_kernel_header = true
+
+#
+# UEFI FD Configs
+#
+[uefi_fd]
+base = 0x9FC00000
+size = 0x300000
+
+#
+# Android Boot Image Kernel Configs
+#
+[boot_image_kernel]
+kernel_compression = "gzip"
+append_dtb         = true
+
+#
+# Android Boot Image Configs
+#
+# The stock Pixel 3 boot image (SP1A.210812.016.C2) uses base 0, kernel 0x8000, ramdisk 0x1000000,
+# tags 0x100 and 4 KiB pages. Header version 1 keeps the device tree appended to the kernel.
+[boot_image]
+header_version = 1
+base           = 0x00000000
+kernel_offset  = 0x00008000
+ramdisk_offset = 0x01000000
+tags_offset    = 0x00000100
+pagesize       = 4096
